    EMPLEADOS ||--o{ PEDIDOS : "atiende"
    ESTADOS_PEDIDO ||--o{ PEDIDOS : "estado"
    CANALES_VENTA ||--o{ PEDIDOS : "canal"
    MEDIOS_CONTACTO_PEDIDO ||--o{ PEDIDOS : "via"
    PEDIDOS ||--o{ PEDIDO_ITEMS : "compuesto_por"
    PRODUCTOS ||--o{ PEDIDO_ITEMS : "referencia"
    TIPOS_PRODUCTO ||--o{ PRODUCTOS : "clasifica"
    CLIENTES ||--o{ PAGOS : "paga"
    PEDIDOS ||--o{ PAGOS : "aplicado_a"
    FORMAS_PAGO ||--o{ PAGOS : "instrumento"
    CLIENTES ||--o{ CLIENTE_CONTACTOS : "tiene"
    TIPOS_CONTACTO_CLIENTE ||--o{ CLIENTE_CONTACTOS : "tipo"
    PROVEEDORES ||--o{ RECEPCIONES_PROVEEDOR : "abastece"
    EMPLEADOS ||--o{ RECEPCIONES_PROVEEDOR : "recibe"
    RECEPCIONES_PROVEEDOR ||--o{ RECEPCION_ITEMS : "compuesto_por"
    PRODUCTOS ||--o{ RECEPCION_ITEMS : "recibido"
    RECEPCIONES_PROVEEDOR ||--o{ GARRAFAS : "ingresa"
    PROVEEDORES ||--o{ GARRAFAS : "origen"
    ESTADOS_GARRAFA ||--o{ GARRAFAS : "estado_actual"
    CLIENTES ||--o{ GARRAFAS : "en_poder_de"
    GARRAFAS ||--o{ MOVIMIENTOS_GARRAFA : "registra"
    TIPOS_MOVIMIENTO_GARRAFA ||--o{ MOVIMIENTOS_GARRAFA : "tipo"
    PEDIDOS ||--o{ MOVIMIENTOS_GARRAFA : "origen"
    RECEPCIONES_PROVEEDOR ||--o{ MOVIMIENTOS_GARRAFA : "origen"
    PROVEEDORES ||--o{ PAGOS_PROVEEDOR : "recibe"
