@model ExtraGasMVC.DTOs.ClienteDto
@{
    var provincias = (IEnumerable<ExtraGasMVC.DTOs.ProvinciaDto>)ViewBag.Provincias;
    var provincia = Model.ProvinciaId.HasValue
        ? provincias.FirstOrDefault(p => p.Id == Model.ProvinciaId.Value)
        : null;
    ViewData["Title"] = "Detalle del cliente";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new() { Label = "Clientes", Controller = "Clientes", Action = "Index" },
        new() { Label = Model.Apellido + ", " + Model.Nombre }
    };
}
@section PageHeader {
    <div class="mb-3 d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-pencil me-1"></i> Editar
        </a>
    </div>
}

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header"><h3 class="card-title">Datos personales</h3></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Código</dt><dd class="col-sm-8"><code>@(Model.Codigo ?? "-")</code></dd>
                    <dt class="col-sm-4">Nombre</dt><dd class="col-sm-8">@Model.Nombre</dd>
                    <dt class="col-sm-4">Apellido</dt><dd class="col-sm-8">@Model.Apellido</dd>
                    <dt class="col-sm-4">DNI</dt><dd class="col-sm-8">@(Model.Dni ?? "-")</dd>
                    <dt class="col-sm-4">CUIT/CUIL</dt><dd class="col-sm-8">@(Model.CuitCuil ?? "-")</dd>
                    <dt class="col-sm-4">Fecha de alta</dt><dd class="col-sm-8">@Model.FechaAlta.ToString("dd/MM/yyyy")</dd>
                    <dt class="col-sm-4">Estado</dt>
                    <dd class="col-sm-8">
                        @if (Model.Activo)
                        {
                            <span class="badge text-bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Inactivo</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header"><h3 class="card-title">Contacto</h3></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Teléfono principal</dt><dd class="col-sm-8">@Model.TelefonoPrincipal</dd>
                    <dt class="col-sm-4">Teléfono secundario</dt><dd class="col-sm-8">@(Model.TelefonoSecundario ?? "-")</dd>
                    <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@(Model.Email ?? "-")</dd>
                </dl>
            </div>
        </div>
        <div class="card mb-4">
            <div class="card-header"><h3 class="card-title">Dirección</h3></div>
            <div class="card-body">
                <dl class="row mb-0">
                    @{
                        var direccionPartes = new[] { Model.Calle, Model.Numero, Model.Piso, Model.Depto }
                            .Where(s => !string.IsNullOrWhiteSpace(s));
                        var direccion = direccionPartes.Any() ? string.Join(" ", direccionPartes) : "-";
                    }
                    <dt class="col-sm-4">Dirección</dt><dd class="col-sm-8">@direccion</dd>
                    <dt class="col-sm-4">Ciudad</dt><dd class="col-sm-8">@(Model.Ciudad ?? "-")</dd>
                    <dt class="col-sm-4">CP</dt><dd class="col-sm-8">@(Model.CodigoPostal ?? "-")</dd>
                    <dt class="col-sm-4">Provincia</dt><dd class="col-sm-8">@(provincia?.Nombre ?? "-")</dd>
                    <dt class="col-sm-4">Referencias</dt><dd class="col-sm-8">@(Model.Referencias ?? "-")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Observaciones))
{
    <div class="card mb-4">
        <div class="card-header"><h3 class="card-title">Observaciones</h3></div>
        <div class="card-body">@Model.Observaciones</div>
    </div>
}
