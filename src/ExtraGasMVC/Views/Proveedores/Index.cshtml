@model ExtraGasMVC.Models.ViewModels.PagedResult<ExtraGasMVC.DTOs.ProveedorDto>
@{
    ViewData["Title"] = "Proveedores";
    var busqueda = ViewBag.Busqueda as string;
    var soloActivos = (bool)(ViewBag.SoloActivos ?? true);
    var pagina = Model.Page;
    var tamanio = Model.PageSize;
    var total = Model.Total;
    var totalPaginas = Model.TotalPages;
}
@section PageHeader {
    <div class="mb-3">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Nuevo proveedor
        </a>
    </div>
}
<div class="card">
    <div class="card-header">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-6">
                <label for="filtroBusqueda" class="form-label small mb-1">Buscar</label>
                <input type="text" id="filtroBusqueda" name="busqueda" value="@busqueda" class="form-control" placeholder="Razón social, CUIT o nombre fantasía" />
            </div>
            <div class="col-md-2">
                <div class="form-check mt-3">
                    <input type="hidden" name="soloActivos" value="false" />
                    <input class="form-check-input" type="checkbox" id="soloActivos" name="soloActivos" value="true" @(soloActivos ? "checked" : "") />
                    <label class="form-check-label" for="soloActivos">Solo activos</label>
                </div>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-search me-1"></i>Buscar</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Razón social</th>
                    <th>Nombre fantasía</th>
                    <th>CUIT</th>
                    <th>Teléfono</th>
                    <th>Ciudad</th>
                    <th class="text-center">Estado</th>
                    <th class="text-end" style="width: 200px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="8" class="text-center py-4 text-secondary">No hay proveedores.</td></tr>
                }
                @foreach (var p in Model.Items)
                {
                    <tr>
                        <td><code>@(p.Codigo ?? "-")</code></td>
                        <td><strong>@p.RazonSocial</strong></td>
                        <td>@(p.NombreFantasia ?? "-")</td>
                        <td>@p.Cuit</td>
                        <td>@(p.TelefonoPrincipal ?? "-")</td>
                        <td>@(p.Ciudad ?? "-")</td>
                        <td class="text-center">
                            @if (p.Activo) { <span class="badge text-bg-success">Activo</span> } else { <span class="badge text-bg-secondary">Inactivo</span> }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-info" title="Ver"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-primary" title="Editar"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline js-confirm-form" data-name="este proveedor">
                                @Html.AntiForgeryToken()
                                <button type="button" class="btn btn-sm btn-danger" title="Eliminar" onclick="confirmarAccion(this)"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer clearfix">
        <div class="float-end">
            <small class="text-secondary me-2">@total registro@(total == 1 ? "" : "s")</small>
        </div>
        @if (totalPaginas > 1)
        {
            <nav>
                <ul class="pagination pagination-sm m-0 float-end">
                    @for (var i = 1; i <= totalPaginas; i++)
                    {
                        <li class="page-item @(i == pagina ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-busqueda="@busqueda"
                               asp-route-soloActivos="@soloActivos"
                               asp-route-pagina="@i"
                               asp-route-tamanio="@tamanio">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>
