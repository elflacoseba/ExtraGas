@model ExtraGasMVC.Data.Entities.Proveedor
@{
    ViewData["Title"] = "Detalle del proveedor";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new() { Label = "Proveedores", Controller = "Proveedores", Action = "Index" },
        new() { Label = Model.RazonSocial }
    };
}
@section PageHeader {
    <div class="mb-3 d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Volver</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil me-1"></i> Editar</a>
    </div>
}
<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header"><h3 class="card-title">Datos fiscales</h3></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Codigo</dt><dd class="col-sm-8"><code>@(Model.Codigo ?? "-")</code></dd>
                    <dt class="col-sm-4">Razon social</dt><dd class="col-sm-8">@Model.RazonSocial</dd>
                    <dt class="col-sm-4">Nombre fantasia</dt><dd class="col-sm-8">@(Model.NombreFantasia ?? "-")</dd>
                    <dt class="col-sm-4">CUIT</dt><dd class="col-sm-8">@Model.Cuit</dd>
                    <dt class="col-sm-4">Estado</dt>
                    <dd class="col-sm-8">
                        @if (Model.Activo) { <span class="badge text-bg-success">Activo</span> } else { <span class="badge text-bg-secondary">Inactivo</span> }
                    </dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header"><h3 class="card-title">Contacto</h3></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Telefono principal</dt><dd class="col-sm-8">@(Model.TelefonoPrincipal ?? "-")</dd>
                    <dt class="col-sm-4">Telefono secundario</dt><dd class="col-sm-8">@(Model.TelefonoSecundario ?? "-")</dd>
                    <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@(Model.Email ?? "-")</dd>
                    <dt class="col-sm-4">Contacto</dt><dd class="col-sm-8">@(Model.ContactoNombre ?? "-")</dd>
                    <dt class="col-sm-4">Tel. contacto</dt><dd class="col-sm-8">@(Model.ContactoTelefono ?? "-")</dd>
                    <dt class="col-sm-4">Email contacto</dt><dd class="col-sm-8">@(Model.ContactoEmail ?? "-")</dd>
                </dl>
            </div>
        </div>
        <div class="card mb-4">
            <div class="card-header"><h3 class="card-title">Direccion</h3></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Calle</dt><dd class="col-sm-8">@(Model.Calle ?? "-") @Model.Numero @(Model.Piso) @(Model.Depto)</dd>
                    <dt class="col-sm-4">Ciudad</dt><dd class="col-sm-8">@(Model.Ciudad ?? "-")</dd>
                    <dt class="col-sm-4">CP</dt><dd class="col-sm-8">@(Model.CodigoPostal ?? "-")</dd>
                    <dt class="col-sm-4">Provincia</dt><dd class="col-sm-8">@(Model.ProvinciaId?.ToString() ?? "-")</dd>
                    <dt class="col-sm-4">Referencias</dt><dd class="col-sm-8">@(Model.Referencias ?? "-")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
@if (!string.IsNullOrEmpty(Model.Observaciones))
{
    <div class="card mb-4">
        <div class="card-header"><h3 class="card-title">Observaciones</h3></div>
        <div class="card-body">@Model.Observaciones</div>
    </div>
}
