@model ExtraGasMVC.DTOs.UpdateProveedorDto
@{
    ViewData["Title"] = "Editar proveedor";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new() { Label = "Proveedores", Controller = "Proveedores", Action = "Index" },
        new() { Label = "Editar" }
    };
}
@section PageHeader {
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Volver</a>
    </div>
}
<div class="card">
    <div class="card-header"><h3 class="card-title">Editar proveedor</h3></div>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="card-body">
            <div class="mb-3"><span class="text-danger">*</span> Campos obligatorios</div>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="Codigo" class="form-label"></label>
                    <input asp-for="Codigo" class="form-control" />
                    <span asp-validation-for="Codigo" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="RazonSocial" class="form-label"></label> <span class="text-danger">*</span>
                    <input asp-for="RazonSocial" class="form-control" />
                    <span asp-validation-for="RazonSocial" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Cuit" class="form-label"></label> <span class="text-danger">*</span>
                    <input asp-for="Cuit" class="form-control" />
                    <span asp-validation-for="Cuit" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NombreFantasia" class="form-label"></label>
                    <input asp-for="NombreFantasia" class="form-control" />
                    <span asp-validation-for="NombreFantasia" class="text-danger"></span>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <div>
                        <span class="form-label">Estado</span>
                        <div>
                            @if ((bool)ViewBag.Activo)
                            {
                                <span class="badge text-bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Inactivo</span>
                            }
                            <small class="d-block text-secondary mt-1">
                                Se gestiona desde <strong>Eliminar</strong> del listado.
                            </small>
                        </div>
                    </div>
                </div>
            </div>
            <h5 class="mt-4">Contacto</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="TelefonoPrincipal" class="form-label"></label>
                    <input asp-for="TelefonoPrincipal" class="form-control" />
                    <span asp-validation-for="TelefonoPrincipal" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="TelefonoSecundario" class="form-label"></label>
                    <input asp-for="TelefonoSecundario" class="form-control" />
                    <span asp-validation-for="TelefonoSecundario" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ContactoNombre" class="form-label"></label>
                    <input asp-for="ContactoNombre" class="form-control" />
                    <span asp-validation-for="ContactoNombre" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ContactoTelefono" class="form-label"></label>
                    <input asp-for="ContactoTelefono" class="form-control" />
                    <span asp-validation-for="ContactoTelefono" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ContactoEmail" class="form-label"></label>
                    <input asp-for="ContactoEmail" class="form-control" />
                    <span asp-validation-for="ContactoEmail" class="text-danger"></span>
                </div>
            </div>
            <h5 class="mt-4">Dirección</h5>
            <div class="row g-3">
                <div class="col-md-5">
                    <label asp-for="Calle" class="form-label"></label>
                    <input asp-for="Calle" class="form-control" />
                    <span asp-validation-for="Calle" class="text-danger"></span>
                </div>
                <div class="col-md-2">
                    <label asp-for="Numero" class="form-label"></label>
                    <input asp-for="Numero" class="form-control" />
                    <span asp-validation-for="Numero" class="text-danger"></span>
                </div>
                <div class="col-md-1">
                    <label asp-for="Piso" class="form-label"></label>
                    <input asp-for="Piso" class="form-control" />
                    <span asp-validation-for="Piso" class="text-danger"></span>
                </div>
                <div class="col-md-1">
                    <label asp-for="Depto" class="form-label"></label>
                    <input asp-for="Depto" class="form-control" />
                    <span asp-validation-for="Depto" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="CodigoPostal" class="form-label"></label>
                    <input asp-for="CodigoPostal" class="form-control" />
                    <span asp-validation-for="CodigoPostal" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Ciudad" class="form-label"></label>
                    <input asp-for="Ciudad" class="form-control" />
                    <span asp-validation-for="Ciudad" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ProvinciaId" class="form-label"></label>
                    <select asp-for="ProvinciaId" class="form-select">
                        <option value="">-- Seleccione provincia --</option>
                        @foreach (var p in (IEnumerable<ExtraGasMVC.DTOs.ProvinciaDto>)ViewBag.Provincias)
                        {
                            <option value="@p.Id">@p.Nombre</option>
                        }
                    </select>
                    <span asp-validation-for="ProvinciaId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Referencias" class="form-label"></label>
                    <input asp-for="Referencias" class="form-control" />
                    <span asp-validation-for="Referencias" class="text-danger"></span>
                </div>
            </div>
            <h5 class="mt-4">Observaciones</h5>
            <label asp-for="Observaciones" class="form-label">Observaciones</label>
            <textarea asp-for="Observaciones" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Observaciones" class="text-danger"></span>
        </div>
        <div class="card-footer d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Guardar cambios</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>
