@{
    var success = TempData["Success"] as string;
    var error = TempData["Error"] as string;
    var info = TempData["Info"] as string;
    var warning = TempData["Warning"] as string;

    var messages = new List<(string Type, string Text)>();
    if (!string.IsNullOrEmpty(success)) messages.Add(("success", success));
    if (!string.IsNullOrEmpty(error)) messages.Add(("error", error));
    if (!string.IsNullOrEmpty(info)) messages.Add(("info", info));
    if (!string.IsNullOrEmpty(warning)) messages.Add(("warning", warning));
}
@if (messages.Any())
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const Toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 4000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.addEventListener('mouseenter', Swal.stopTimer);
                    toast.addEventListener('mouseleave', Swal.resumeTimer);
                }
            });
            @foreach (var m in messages)
            {
                <text>Toast.fire({ icon: '@m.Type', title: @Html.Raw(Json.Serialize(m.Text)) });</text>
            }
        });
    </script>
}
