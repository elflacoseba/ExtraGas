@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<div class="error-page d-flex align-items-center min-vh-100 py-5">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-md-8 col-lg-6">
                <div class="display-1 fw-bold text-danger lh-1 mb-3">
                    <i class="bi bi-exclamation-octagon-fill"></i>
                </div>
                <h1 class="h3 mb-3">Ha ocurrido un error inesperado.</h1>
                @if (Model.ShowRequestId)
                {
                    <p class="text-secondary">
                        <strong>Request ID:</strong> <code>@Model.RequestId</code>
                    </p>
                }
                <p class="text-secondary mb-4">
                    Por favor intente nuevamente. Si el problema persiste, contacte al administrador.
                </p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-house-door me-1"></i> Volver al inicio
                </a>
            </div>
        </div>
    </div>
</div>
