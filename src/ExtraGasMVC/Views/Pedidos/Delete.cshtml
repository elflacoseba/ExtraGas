@model ExtraGasMVC.DTOs.PedidoDto
@{
    ViewData["Title"] = "Eliminar pedido";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new() { Label = "Pedidos", Controller = "Pedidos", Action = "Index" },
        new() { Label = "Eliminar" }
    };
}
@section PageHeader {
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </div>
}
<div class="card border-danger">
    <div class="card-header bg-danger text-white">
        <h3 class="card-title mb-0"><i class="bi bi-exclamation-triangle me-1"></i> Confirmar eliminación</h3>
    </div>
    <div class="card-body">
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle-fill me-1"></i>
            <strong>Atención:</strong> Esta acción eliminará el pedido. Si el pedido tiene pagos registrados, no podrá ser eliminado.
        </div>
        <dl class="row mb-0">
            <dt class="col-sm-3">Número</dt><dd class="col-sm-9"><strong>@(Model.Numero ?? "-")</strong></dd>
            <dt class="col-sm-3">Fecha</dt><dd class="col-sm-9">@Model.Fecha.ToShortDateTime()</dd>
            <dt class="col-sm-3">Cliente</dt><dd class="col-sm-9">@(Model.ClienteNombre ?? "-")</dd>
            <dt class="col-sm-3">Total</dt><dd class="col-sm-9">@Model.Total.ToArs()</dd>
            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">
                <span class="badge" style="background-color: @(Model.EstadoColor ?? "#6c757d")">@(Model.EstadoNombre ?? "-")</span>
            </dd>
        </dl>
    </div>
    <div class="card-footer d-flex gap-2">
        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash me-1"></i> Sí, eliminar pedido
            </button>
        </form>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</div>
