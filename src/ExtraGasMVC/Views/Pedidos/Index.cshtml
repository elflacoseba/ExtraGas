@model IEnumerable<ExtraGasMVC.DTOs.PedidoDto>
@{
    ViewData["Title"] = "Pedidos";
    var numero = ViewBag.Numero as string;
    var estadoId = ViewBag.EstadoId as ulong?;
    var desde = ViewBag.Desde as DateTime?;
    var hasta = ViewBag.Hasta as DateTime?;
    var pagina = (int)(ViewBag.Pagina ?? 1);
    var tamanio = (int)(ViewBag.Tamanio ?? 25);
    var total = (int)(ViewBag.Total ?? 0);
    var totalPaginas = tamanio > 0 ? (int)Math.Ceiling(total / (double)tamanio) : 0;
    var estados = (IEnumerable<ExtraGasMVC.DTOs.EstadoPedidoDto>)(ViewBag.Estados ?? Array.Empty<ExtraGasMVC.DTOs.EstadoPedidoDto>());
}
@section PageHeader {
    <div class="row mb-3">
        <div class="col-12">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i> Nuevo pedido
            </a>
            <a asp-action="Pendientes" class="btn btn-warning float-end">
                <i class="bi bi-exclamation-triangle me-1"></i> Pendientes de cobro
            </a>
        </div>
    </div>
}
<div class="card">
    <div class="card-header">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small mb-1">Número</label>
                <input type="text" name="numero" value="@numero" class="form-control" placeholder="PED-2026-00001" />
            </div>
            <div class="col-md-3">
                <label class="form-label small mb-1">Estado</label>
                <select name="estadoId" class="form-select">
                    <option value="">Todos</option>
                    @foreach (var e in estados)
                    {
                        <option value="@e.Id" selected="@(estadoId == e.Id)">@e.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">Desde</label>
                <input type="date" name="desde" value="@(desde?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">Hasta</label>
                <input type="date" name="hasta" value="@(hasta?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-search me-1"></i>Filtrar</button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Limpiar filtros">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th>Número</th>
                    <th>Fecha</th>
                    <th>Cliente</th>
                    <th class="text-end">Total</th>
                    <th class="text-end">Pagado</th>
                    <th class="text-end">Saldo</th>
                    <th>Estado</th>
                    <th class="text-end" style="width: 180px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center py-4 text-secondary">No hay pedidos.</td></tr>
                }
                @foreach (var p in Model)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none"><strong>@(p.Numero ?? "-")</strong></a></td>
                        <td>@p.Fecha.ToShortDate()</td>
                        <td>@(p.ClienteNombre ?? "-")</td>
                        <td class="text-end">@p.Total.ToArs()</td>
                        <td class="text-end">@p.MontoPagado.ToArs()</td>
                        <td class="text-end @(p.Saldo > 0 ? "text-danger fw-semibold" : "text-success")">@p.Saldo.ToArs()</td>
                        <td>
                            <span class="badge" style="background-color: @(p.EstadoColor ?? "#6c757d")">@(p.EstadoNombre ?? "-")</span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-info" title="Ver detalle">
                                <i class="bi bi-eye"></i>
                            </a>
                            @if (p.EstadoCodigo != "ENTREGADO" && p.EstadoCodigo != "CANCELADO")
                            {
                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-primary" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            }
                            <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-danger" title="Eliminar">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer clearfix">
        @if (totalPaginas > 1)
        {
            <nav>
                <ul class="pagination pagination-sm m-0 float-end">
                    @for (var i = 1; i <= totalPaginas; i++)
                    {
                        <li class="page-item @(i == pagina ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-numero="@numero"
                               asp-route-estadoId="@estadoId"
                               asp-route-desde="@(desde?.ToString("yyyy-MM-dd"))"
                               asp-route-hasta="@(hasta?.ToString("yyyy-MM-dd"))"
                               asp-route-pagina="@i"
                               asp-route-tamanio="@tamanio">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
        <small class="text-secondary">@total pedido@(total == 1 ? "" : "s")</small>
    </div>
</div>
