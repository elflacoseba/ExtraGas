@model ExtraGasMVC.DTOs.PedidoDto
@{
    ViewData["Title"] = "Detalle del pedido";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new() { Label = "Pedidos", Controller = "Pedidos", Action = "Index" },
        new() { Label = Model.Numero ?? "#" + Model.Id }
    };
}
@section PageHeader {
    <div class="mb-3 d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-pencil me-1"></i> Editar
        </a>
        <a asp-controller="Pagos" asp-action="Create" asp-route-pedidoId="@Model.Id" class="btn btn-success">
            <i class="bi bi-cash-coin me-1"></i> Registrar pago
        </a>
    </div>
}
<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header"><h3 class="card-title">Datos del pedido</h3></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Número</dt><dd class="col-sm-7"><strong>@(Model.Numero ?? "-")</strong></dd>
                    <dt class="col-sm-5">Fecha</dt><dd class="col-sm-7">@Model.Fecha.ToShortDateTime()</dd>
                    <dt class="col-sm-5">Fecha de entrega</dt><dd class="col-sm-7">@Model.FechaEntrega.ToShortDate()</dd>
                    <dt class="col-sm-5">Cliente</dt><dd class="col-sm-7">@(Model.ClienteNombre ?? "-")</dd>
                    <dt class="col-sm-5">Empleado</dt><dd class="col-sm-7">@(Model.EmpleadoNombre ?? "-")</dd>
                    <dt class="col-sm-5">Canal de venta</dt><dd class="col-sm-7">@(Model.CanalNombre ?? "-")</dd>
                    <dt class="col-sm-5">Medio de contacto</dt><dd class="col-sm-7">@(Model.MedioContactoNombre ?? "-")</dd>
                    <dt class="col-sm-5">Estado</dt>
                    <dd class="col-sm-7">
                        <span class="badge" style="background-color: @(Model.EstadoColor ?? "#6c757d")">@(Model.EstadoNombre ?? "-")</span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header"><h3 class="card-title">Totales</h3></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Subtotal</dt><dd class="col-sm-8 text-end">@Model.Subtotal.ToArs()</dd>
                    <dt class="col-sm-4">Descuento</dt><dd class="col-sm-8 text-end text-danger">- @Model.Descuento.ToArs()</dd>
                    <dt class="col-sm-4">Total</dt><dd class="col-sm-8 text-end fw-bold fs-5">@Model.Total.ToArs()</dd>
                    <dt class="col-sm-4">Pagado</dt><dd class="col-sm-8 text-end text-success">@Model.MontoPagado.ToArs()</dd>
                    <dt class="col-sm-4">Saldo</dt><dd class="col-sm-8 text-end @(Model.Saldo > 0 ? "text-danger fw-bold" : "text-success")">@Model.Saldo.ToArs()</dd>
                </dl>
            </div>
        </div>
        <div class="card mb-4">
            <div class="card-header"><h3 class="card-title">Dirección de entrega</h3></div>
            <div class="card-body">@(Model.DireccionEntrega ?? "-")</div>
        </div>
    </div>
</div>

@if (Model.Items.Any())
{
    <div class="card mb-4">
        <div class="card-header"><h3 class="card-title">Items del pedido</h3></div>
        <div class="card-body table-responsive p-0">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Tipo</th>
                        <th class="text-end">Cantidad</th>
                        <th class="text-end">Precio unitario</th>
                        <th class="text-end">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <strong>@(item.ProductoNombre ?? "-")</strong>
                                @if (!string.IsNullOrEmpty(item.ProductoCodigo))
                                {
                                    <br /><small class="text-secondary">@item.ProductoCodigo</small>
                                }
                            </td>
                            <td>
                                @switch (item.TipoLinea)
                                {
                                    case "ENTREGA":
                                        <span class="badge text-bg-primary">Entrega</span>
                                        break;
                                    case "DEVOLUCION":
                                        <span class="badge text-bg-warning">Devolución</span>
                                        break;
                                    case "VENTA":
                                        <span class="badge text-bg-info">Venta</span>
                                        break;
                                }
                            </td>
                            <td class="text-end">@item.Cantidad</td>
                            <td class="text-end">@item.PrecioUnitario.ToArs()</td>
                            <td class="text-end fw-semibold @(item.TipoLinea == "DEVOLUCION" ? "text-danger" : "")">
                                @(item.TipoLinea == "DEVOLUCION" ? "- " : "")@item.Subtotal.ToArs()
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(Model.Observaciones))
{
    <div class="card mb-4">
        <div class="card-header"><h3 class="card-title">Observaciones</h3></div>
        <div class="card-body">@Model.Observaciones</div>
    </div>
}
