@model IEnumerable<ExtraGasMVC.Data.Entities.PagoProveedor>
@{
    ViewData["Title"] = "Pagos a proveedores";
    var pagina = (int)(ViewBag.Pagina ?? 1);
    var tamanio = (int)(ViewBag.Tamanio ?? 25);
    var total = (int)(ViewBag.Total ?? 0);
    var totalPaginas = tamanio > 0 ? (int)Math.Ceiling(total / (double)tamanio) : 0;
}
<div class="card">
    <div class="card-header"><h3 class="card-title">Pagos a proveedores</h3></div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th>Numero</th>
                    <th>Fecha</th>
                    <th>Proveedor</th>
                    <th>Recepcion</th>
                    <th>Forma</th>
                    <th class="text-end">Monto</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center py-4 text-secondary">No hay pagos a proveedores.</td></tr>
                }
                @foreach (var p in Model)
                {
                    <tr>
                        <td><strong>@(p.Numero ?? "-")</strong></td>
                        <td>@p.Fecha.ToShortDate()</td>
                        <td>#@p.ProveedorId</td>
                        <td>@(p.RecepcionId?.ToString() ?? "-")</td>
                        <td>#@p.FormaPagoId</td>
                        <td class="text-end fw-semibold">@p.Monto.ToArs()</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer clearfix">
        @if (totalPaginas > 1)
        {
            <nav>
                <ul class="pagination pagination-sm m-0 float-end">
                    @for (var i = 1; i <= totalPaginas; i++)
                    {
                        <li class="page-item @(i == pagina ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-tamanio="@tamanio">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
        <small class="text-secondary">@total pago@(total == 1 ? "" : "s")</small>
    </div>
</div>
