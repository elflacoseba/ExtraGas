@model ExtraGasMVC.Data.Entities.Pago
@{
    ViewData["Title"] = "Registrar pago";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new() { Label = "Pagos", Controller = "Pagos", Action = "Index" },
        new() { Label = "Nuevo" }
    };
    var pedidos = ViewBag.Pedidos as IEnumerable<ExtraGasMVC.Data.Entities.Pedido> ?? Array.Empty<ExtraGasMVC.Data.Entities.Pedido>();
    var clientes = ViewBag.Clientes as IEnumerable<ExtraGasMVC.Data.Entities.Cliente> ?? Array.Empty<ExtraGasMVC.Data.Entities.Cliente>();
    var formas = ViewBag.FormasPago as IEnumerable<ExtraGasMVC.Data.Entities.FormaPago> ?? Array.Empty<ExtraGasMVC.Data.Entities.FormaPago>();
}
@section PageHeader {
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Volver</a>
    </div>
}
<div class="card">
    <div class="card-header"><h3 class="card-title">Registrar pago</h3></div>
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="NumeroRecibo" class="form-label"></label>
                    <input asp-for="NumeroRecibo" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Fecha" class="form-label"></label>
                    <input asp-for="Fecha" type="datetime-local" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <label asp-for="ClienteId" class="form-label"></label>
                    <select asp-for="ClienteId" class="form-select" required>
                        <option value="">-- Seleccione cliente --</option>
                        @foreach (var c in clientes)
                        {
                            <option value="@c.Id">@c.Apellido, @c.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="PedidoId" class="form-label"></label>
                    <select asp-for="PedidoId" class="form-select">
                        <option value="0">-- Sin pedido --</option>
                        @foreach (var p in pedidos)
                        {
                            <option value="@p.Id">@(p.Numero ?? "#" + p.Id) (Saldo: @p.Saldo.ToArs())</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="FormaPagoId" class="form-label"></label>
                    <select asp-for="FormaPagoId" class="form-select" required>
                        <option value="">-- Forma de pago --</option>
                        @foreach (var f in formas)
                        {
                            <option value="@f.Id">@f.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="Monto" class="form-label"></label>
                    <input asp-for="Monto" type="number" step="0.01" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="Referencia" class="form-label"></label>
                    <input asp-for="Referencia" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="Observaciones" class="form-label"></label>
                    <textarea asp-for="Observaciones" class="form-control" rows="2"></textarea>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex gap-2">
            <button type="submit" class="btn btn-success"><i class="bi bi-save me-1"></i> Registrar pago</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>
