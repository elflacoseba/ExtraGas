@model ExtraGasMVC.DTOs.UsuarioDto
@using ExtraGasMVC.Extensions
@{
    ViewData["Title"] = "Detalle del usuario";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new() { Label = "Usuarios", Controller = "Usuarios", Action = "Index" },
        new() { Label = Model.Username }
    };
}
@section PageHeader {
    <div class="mb-3 d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="bi bi-pencil me-1"></i> Editar
        </a>
    </div>
}

<div class="row">
    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header"><h3 class="card-title">Datos del usuario</h3></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Username</dt>
                    <dd class="col-sm-8"><strong>@Model.Username</strong></dd>
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@(Model.Email ?? "-")</dd>
                    <dt class="col-sm-4">Rol</dt>
                    <dd class="col-sm-8">@(Model.RolNombre ?? "-")</dd>
                    <dt class="col-sm-4">Estado</dt>
                    <dd class="col-sm-8">
                        @if (Model.Activo)
                        {
                            <span class="badge text-bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Inactivo</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        @if (Model.EmpleadoNombre is not null)
        {
            <div class="card mb-4">
                <div class="card-header"><h3 class="card-title">Empleado vinculado</h3></div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Empleado</dt>
                        <dd class="col-sm-8">@Model.EmpleadoNombre</dd>
                    </dl>
                </div>
            </div>
        }
    </div>

    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-header"><h3 class="card-title">Actividad</h3></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Ultimo login</dt>
                    <dd class="col-sm-8">@Model.UltimoLogin.ToShortDateTime()</dd>
                </dl>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header"><h3 class="card-title">Auditoria</h3></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Creado</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToShortDateTime()</dd>
                    <dt class="col-sm-4">Creado por</dt>
                    <dd class="col-sm-8">@(Model.CreadoPor ?? "-")</dd>
                    <dt class="col-sm-4">Actualizado</dt>
                    <dd class="col-sm-8">@Model.UpdatedAt.ToShortDateTime()</dd>
                    <dt class="col-sm-4">Actualizado por</dt>
                    <dd class="col-sm-8">@(Model.ActualizadoPor ?? "-")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
