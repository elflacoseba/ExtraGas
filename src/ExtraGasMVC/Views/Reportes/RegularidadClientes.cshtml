@model IEnumerable<ExtraGasMVC.Data.Entities.Views.VRegularidadCliente>
@{
    ViewData["Title"] = "Regularidad de clientes";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new() { Label = "Reportes" },
        new() { Label = "Regularidad" }
    };
}
<div class="card">
    <div class="card-header"><h3 class="card-title">Regularidad de clientes</h3></div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th class="text-end">Total pedidos</th>
                    <th>Primer pedido</th>
                    <th>Ultimo pedido</th>
                    <th class="text-end">Dias promedio</th>
                    <th class="text-end">Total facturado</th>
                    <th class="text-end">Saldo pendiente</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center py-4 text-secondary">Sin datos.</td></tr>
                }
                @foreach (var r in Model)
                {
                    <tr>
                        <td><strong>@r.Cliente</strong></td>
                        <td class="text-end">@r.TotalPedidos</td>
                        <td>@r.PrimerPedido.ToShortDate()</td>
                        <td>@r.UltimoPedido.ToShortDate()</td>
                        <td class="text-end">@(r.DiasPromedioEntrePedidos?.ToString("0.0") ?? "-")</td>
                        <td class="text-end">@r.TotalFacturado.ToArs()</td>
                        <td class="text-end @(r.SaldoPendiente > 0 ? "text-danger" : "text-success")">@r.SaldoPendiente.ToArs()</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
