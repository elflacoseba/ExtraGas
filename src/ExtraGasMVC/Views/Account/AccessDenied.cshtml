@{
    ViewData["Title"] = "Acceso denegado";
    Layout = "_AccountLayout";
}
<div class="login-box">
    <div class="card">
        <div class="card-body login-card-body text-center">
            <i class="bi bi-shield-lock display-1 text-danger"></i>
            <h3 class="mt-3">Acceso denegado</h3>
