@model ExtraGasMVC.DTOs.ProductoDto
@{
    ViewData["Title"] = "Detalle del producto";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new() { Label = "Productos", Controller = "Productos", Action = "Index" },
        new() { Label = Model.Nombre }
    };
}
@section PageHeader {
    <div class="mb-3 d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Volver</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil me-1"></i> Editar</a>
    </div>
}
<div class="card">
    <div class="card-header"><h3 class="card-title">@Model.Nombre</h3></div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Código</dt><dd class="col-sm-9"><code>@Model.Codigo</code></dd>
            <dt class="col-sm-3">Nombre</dt><dd class="col-sm-9">@Model.Nombre</dd>
            <dt class="col-sm-3">Descripción</dt><dd class="col-sm-9">@(Model.Descripcion ?? "-")</dd>
            <dt class="col-sm-3">Tipo de producto</dt><dd class="col-sm-9">@Model.TipoProductoNombre</dd>
            <dt class="col-sm-3">Capacidad (kg)</dt><dd class="col-sm-9">@(Model.CapacidadKg?.ToString("0.##") ?? "-")</dd>
            <dt class="col-sm-3">Unidad de venta</dt><dd class="col-sm-9">@Model.UnidadVenta</dd>
            <dt class="col-sm-3">Precio actual</dt><dd class="col-sm-9">@Model.PrecioActual.ToArs()</dd>
            <dt class="col-sm-3">Maneja garrafa individual</dt>
            <dd class="col-sm-9">
                @if (Model.ManejaGarrafaIndividual) { <span class="badge text-bg-info">Sí</span> } else { <span class="badge text-bg-light">No</span> }
            </dd>
            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">
                @if (Model.Activo) { <span class="badge text-bg-success">Activo</span> } else { <span class="badge text-bg-secondary">Inactivo</span> }
            </dd>
        </dl>
    </div>
</div>

@* Issue #147 item 4: tarjeta de auditoría (separada del card principal para
   que el operador la identifique visualmente como metadata, no como datos
   editables). El DTO expone 4 miembros — CreatedAt/UpdatedAt se mapean por
   convención desde la entity, CreatedByUserName/UpdatedByUserName los
   resuelve el Service vía LoadAuditUsersAsync. Si el auditor fue borrado
   los usernames quedan null ("-"). *@
<div class="card mt-3">
    <div class="card-header"><h3 class="card-title">Auditoría</h3></div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.CreatedAt)</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToShortDateTime()</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.UpdatedAt)</dt>
            <dd class="col-sm-9">@Model.UpdatedAt.ToShortDateTime()</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.CreatedByUserName)</dt>
            <dd class="col-sm-9">@(Model.CreatedByUserName ?? "-")</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(m => m.UpdatedByUserName)</dt>
            <dd class="col-sm-9">@(Model.UpdatedByUserName ?? "-")</dd>
        </dl>
    </div>
</div>
