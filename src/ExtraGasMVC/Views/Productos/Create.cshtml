@model ExtraGasMVC.DTOs.CreateProductoDto
@{
    ViewData["Title"] = "Nuevo producto";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new() { Label = "Productos", Controller = "Productos", Action = "Index" },
        new() { Label = "Nuevo" }
    };
}
@section PageHeader {
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Volver</a>
    </div>
}
<div class="card">
    <div class="card-header"><h3 class="card-title">Nuevo producto</h3></div>
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="small text-secondary mb-3"><span class="text-danger">*</span> Campos obligatorios</div>
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="Codigo" class="form-label">Código</label> <span class="text-danger">*</span>
                    <input asp-for="Codigo" class="form-control" />
                    <span asp-validation-for="Codigo" class="text-danger small"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="Nombre" class="form-label"></label> <span class="text-danger">*</span>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="TipoProductoId" class="form-label">Tipo de producto</label> <span class="text-danger">*</span>
                    <select asp-for="TipoProductoId" class="form-select">
                        <option value="">-- Seleccione tipo --</option>
                        @foreach (var tp in (IEnumerable<ExtraGasMVC.DTOs.TipoProductoDto>)ViewBag.TiposProducto)
                        {
                            <option value="@tp.Id">@tp.Nombre</option>
                        }
                    </select>
                    <span asp-validation-for="TipoProductoId" class="text-danger small"></span>
                </div>
                <div class="col-md-2">
                    <label asp-for="CapacidadKg" class="form-label"></label>
                    <input asp-for="CapacidadKg" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="UnidadVenta" class="form-label"></label>
                    <input asp-for="UnidadVenta" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="PrecioActual" class="form-label"></label> <span class="text-danger">*</span>
                    <input asp-for="PrecioActual" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="PrecioActual" class="text-danger small"></span>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <div class="form-check">
                        <input asp-for="ManejaGarrafaIndividual" class="form-check-input" type="checkbox" />
                        <label asp-for="ManejaGarrafaIndividual" class="form-check-label">Maneja garrafa individual</label>
                    </div>
                </div>
                <div class="col-12">
                    <label asp-for="Descripcion" class="form-label">Descripción</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                </div>
            </div>
        </div>
        <div class="card-footer d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i> Guardar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </div>
    </form>
</div>
