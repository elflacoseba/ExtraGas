@model ExtraGasMVC.Models.ViewModels.PagedResult<ExtraGasMVC.Data.Entities.Views.VGarrafaEnCliente>
@{
    ViewData["Title"] = "Garrafas en poder del cliente";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new() { Label = "Garrafas", Controller = "Garrafas", Action = "Index" },
        new() { Label = "En clientes" }
    };
    var cliente = ViewBag.Cliente as ExtraGasMVC.DTOs.ClienteDto;
    var clienteId = ViewBag.ClienteId as ulong?;

    // Issue #182 T11: variables de paginación reutilizadas por los links.
    var currentPage = Model.Page;
    var totalPages = Model.TotalPages;
    var pageSize = Model.PageSize;
    var total = Model.Total;

    // RouteValues base para los links de paginación: preservan clienteId
    // (filtro del dropdown) y resetean page a la pagina destino.
    var routeValues = new Dictionary<string, string>();
    if (clienteId.HasValue) routeValues["clienteId"] = clienteId.Value.ToString();

    IDictionary<string, string> BuildPageLink(int pageNumber)
    {
        var copy = new Dictionary<string, string>(routeValues) { ["page"] = pageNumber.ToString() };
        return copy;
    }

    // Issue #182 T11: ventana de números de página centrada en la actual
    // (max 5 botones), mismo patrón que Views/Garrafas/Index.cshtml.
    const int windowSize = 5;
    int startPage = Math.Max(1, currentPage - windowSize / 2);
    int endPage = Math.Min(totalPages, startPage + windowSize - 1);
    if (endPage - startPage + 1 < windowSize && totalPages >= windowSize)
        startPage = Math.Max(1, endPage - windowSize + 1);

    // Mostrando X-Y de Z: si total == 0 mostramos "0" en ambos extremos.
    int firstItem = total == 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
    int lastItem = total == 0 ? 0 : Math.Min(currentPage * pageSize, total);
}
@section PageHeader {
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Volver</a>
    </div>
}
@if (cliente is not null)
{
    <div class="alert alert-info">
        Mostrando garrafas en poder de <strong>@cliente.Apellido, @cliente.Nombre</strong>.
    </div>
}
<div class="card">
    <div class="card-header">
        <h3 class="card-title">Garrafas asignadas a clientes</h3>
    </div>
    <div class="card-body table-responsive p-0">
        <table class="table table-hover table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th>Codigo</th>
                    <th class="text-end">Capacidad (kg)</th>
                    <th>Cliente</th>
                    <th>F. ultimo mov.</th>
                    <th class="text-end">Días en cliente</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="5" class="text-center py-4 text-secondary">No hay garrafas en poder del cliente.</td></tr>
                }
                @foreach (var g in Model.Items)
                {
                    <tr>
                        <td><code>@g.Codigo</code></td>
                        <td class="text-end">@g.CapacidadKg</td>
                        <td>
                            @if (g.ClienteId > 0 && !string.IsNullOrWhiteSpace(g.Cliente))
                            {
                                <a asp-controller="Clientes" asp-action="Details" asp-route-id="@g.ClienteId">@g.Cliente</a>
                            }
                            else if (cliente is not null)
                            {
                                <span>@cliente.Apellido, @cliente.Nombre</span>
                            }
                        </td>
                        <td>@g.FechaUltimoMovimiento?.ToShortDateString()</td>
                        @* Issue #51: dias_en_cliente calculado en v_garrafas_en_clientes. *@
                        <td class="text-end">@(g.DiasEnCliente?.ToString() ?? "—")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @* Issue #182 T11: pie de tabla con controles de paginación. Mismo
       patrón que Views/Garrafas/Index.cshtml (card-footer + pagination-sm +
       ventana centrada de 5 botones). Los links preservan clienteId. *@
    @if (total > 0)
    {
        <div class="card-footer d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="text-secondary small">
                Mostrando <strong>@firstItem-@lastItem</strong> de <strong>@total</strong> garrafas.
                Pagina <strong>@currentPage</strong> de <strong>@totalPages</strong>.
            </div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.HasPrevious ? string.Empty : "disabled")">
                        <a class="page-link" asp-action="EnClientes" asp-all-route-data="@(BuildPageLink(Math.Max(1, currentPage - 1)))">
                            <i class="bi bi-chevron-left"></i> Anterior
                        </a>
                    </li>
                    @for (int p = startPage; p <= endPage; p++)
                    {
                        <li class="page-item @(p == currentPage ? "active" : string.Empty)">
                            <a class="page-link" asp-action="EnClientes" asp-all-route-data="@(BuildPageLink(p))">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.HasNext ? string.Empty : "disabled")">
                        <a class="page-link" asp-action="EnClientes" asp-all-route-data="@(BuildPageLink(Math.Min(totalPages, currentPage + 1)))">
                            Siguiente <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
<p class="text-secondary small mt-3">
    Datos en vivo desde la vista <code>v_garrafas_en_clientes</code> de la base de datos (issue #51).
</p>
